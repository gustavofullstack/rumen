[Desktop Entry]
Type=Application
Name=RUMEN
GenericName=Navegador Web
Comment=Navegador open source escrito em Rust
Exec=rumen %U
Icon=rumen
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=rumen
Actions=private;tor;

[Desktop Action private]
Name=Nova janela privada
Exec=rumen --private

[Desktop Action tor]
Name=Nova janela Tor
Exec=rumen --tor
